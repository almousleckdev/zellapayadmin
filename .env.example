# ZellaPay Admin environment. Copy to .env.local; never commit real values.

# [server] Backend base URL for this environment
ZELLAPAY_API_URL=http://localhost:8080

# [server] At least 32 random bytes; encrypts the session cookie.
# Generate one with: openssl rand -base64 32. Use a different one from the
# merchant dashboard's.
SESSION_SECRET=

# [server] Optional. The header your edge overwrites with the real client
# address. Leave empty if no trusted edge sets one.
CLIENT_IP_HEADER=
